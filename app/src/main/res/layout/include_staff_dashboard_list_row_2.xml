<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_inner_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textItemTitle2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:maxLines="2"
            android:text="Book title"
            android:textColor="@color/student_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textItemBadge2"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_badge_pending"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Pending"
            android:textColor="@color/student_yellow"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textItemMeta2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Student"
        android:textColor="@color/student_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textItemDate2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Date"
        android:textColor="@color/student_text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/actionRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/buttonPrimary2"
            style="@style/StaffPortalPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Accept" />

        <TextView
            android:id="@+id/buttonSecondary2"
            style="@style/StaffPortalOutlineButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Reject" />
    </LinearLayout>

    <TextView
        android:id="@+id/buttonReturn2"
        style="@style/StaffPortalOutlineButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:text="Return Book"
        android:visibility="gone" />
</LinearLayout>
