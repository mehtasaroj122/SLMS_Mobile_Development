<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!--
        Cleartext HTTP is kept for local Laravel testing only.
        The live hosted API uses HTTPS and does not require cleartext traffic.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
