<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:clipToPadding="false"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/splashLogoCard"
            android:layout_width="156dp"
            android:layout_height="156dp"
            android:background="@drawable/bg_splash_logo_card"
            android:elevation="14dp"
            android:padding="14dp">

            <ImageView
                android:id="@+id/imageViewLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/lms_logo" />

        </FrameLayout>

        <TextView
            android:id="@+id/textViewSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.88"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:text="Library Management System"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progressBarSplash"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="128dp"
            android:layout_height="4dp"
            android:layout_marginTop="34dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/white" />

    </LinearLayout>

</FrameLayout>
