<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registrationScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/registrationContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <include
            android:id="@+id/authBrandHeader"
            layout="@layout/component_auth_brand_header"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/textViewRegisterBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:background="@drawable/bg_auth_register_badge"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="REGISTER"
            android:textColor="@color/auth_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="Complete your account"
            android:textColor="@color/auth_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="Use your invited email, ID, and phone to finish setup."
            android:textColor="@color/auth_text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/registrationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/frameRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutRole"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/auth_input_bg"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/auth_input_stroke"
                    app:boxStrokeErrorColor="@color/error_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconTint="@color/auth_icon"
                    app:errorEnabled="false"
                    app:errorTextColor="@color/error_color"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_user"
                    app:startIconTint="@color/auth_icon">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Role"
                        android:includeFontPadding="false"
                        android:inputType="none"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp"
                        android:singleLine="true"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_hint"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/floatingLabelRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:background="@color/auth_card"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Role"
                    android:textColor="@color/auth_secondary"
                    android:textSize="15sp"
                    android:visibility="visible" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/auth_input_bg"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/auth_input_stroke"
                    app:boxStrokeErrorColor="@color/error_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:errorEnabled="false"
                    app:errorTextColor="@color/error_color"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/auth_icon">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:autofillHints="emailAddress"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Email address"
                        android:includeFontPadding="false"
                        android:inputType="textEmailAddress"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp"
                        android:singleLine="true"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_hint"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/floatingLabelEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:background="@color/auth_card"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Email address"
                    android:textColor="@color/auth_secondary"
                    android:textSize="15sp"
                    android:visibility="visible" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameIdentifier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutIdentifier"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/auth_input_bg"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/auth_input_stroke"
                    app:boxStrokeErrorColor="@color/error_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:errorEnabled="false"
                    app:errorTextColor="@color/error_color"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_id_card"
                    app:startIconTint="@color/auth_icon">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextIdentifier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Student ID"
                        android:includeFontPadding="false"
                        android:inputType="textCapCharacters"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp"
                        android:singleLine="true"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_hint"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/floatingLabelIdentifier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:background="@color/auth_card"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Student ID"
                    android:textColor="@color/auth_secondary"
                    android:textSize="15sp"
                    android:visibility="visible" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/framePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutPhone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/auth_input_bg"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/auth_input_stroke"
                    app:boxStrokeErrorColor="@color/error_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:errorEnabled="false"
                    app:errorTextColor="@color/error_color"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/auth_icon">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:autofillHints="phone"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Phone number"
                        android:includeFontPadding="false"
                        android:inputType="phone"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp"
                        android:singleLine="true"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_hint"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/floatingLabelPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:background="@color/auth_card"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Phone number"
                    android:textColor="@color/auth_secondary"
                    android:textSize="15sp"
                    android:visibility="visible" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/framePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/auth_input_bg"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/auth_input_stroke"
                    app:boxStrokeErrorColor="@color/error_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconContentDescription="Show password"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/auth_icon"
                    app:errorEnabled="false"
                    app:errorTextColor="@color/error_color"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/auth_icon">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:autofillHints="newPassword"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Password"
                        android:includeFontPadding="false"
                        android:inputType="textPassword"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp"
                        android:singleLine="true"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_hint"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/floatingLabelPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:background="@color/auth_card"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Password"
                    android:textColor="@color/auth_secondary"
                    android:textSize="15sp"
                    android:visibility="visible" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutConfirmPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/auth_input_bg"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/auth_input_stroke"
                    app:boxStrokeErrorColor="@color/error_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconContentDescription="Show confirm password"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/auth_icon"
                    app:errorEnabled="false"
                    app:errorTextColor="@color/error_color"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/auth_icon">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:autofillHints="newPassword"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:hint="Confirm password"
                        android:includeFontPadding="false"
                        android:inputType="textPassword"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp"
                        android:singleLine="true"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_hint"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/floatingLabelConfirmPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:background="@color/auth_card"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Confirm password"
                    android:textColor="@color/auth_secondary"
                    android:textSize="15sp"
                    android:visibility="visible" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_profile_warning_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="Password requirements"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textReqLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="-- At least 8 characters"
                    android:textColor="@color/profile_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textReqUppercase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:text="-- At least one uppercase letter"
                    android:textColor="@color/profile_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textReqLowercase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:text="-- At least one lowercase letter"
                    android:textColor="@color/profile_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textReqNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:text="-- At least one number"
                    android:textColor="@color/profile_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textReqSymbol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:text="-- At least one symbol"
                    android:textColor="@color/profile_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textReqMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:text="-- Passwords must match"
                    android:textColor="@color/profile_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <include
                android:id="@+id/buttonCompleteRegistration"
                layout="@layout/component_auth_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <include
                layout="@layout/component_auth_security_badge"
                android:layout_width="match_parent"
                android:layout_height="54dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Already registered? "
                android:textColor="@color/auth_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textViewSignIn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Sign in"
                android:textColor="@color/auth_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
