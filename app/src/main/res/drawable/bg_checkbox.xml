<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/auth_input_bg" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/auth_secondary" />
                    <corners android:radius="4dp" />
                    <size
                        android:width="22dp"
                        android:height="22dp" />
                </shape>
            </item>
            <item
                android:width="18dp"
                android:height="18dp"
                android:drawable="@drawable/ic_check_auth"
                android:gravity="center" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/auth_input_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/auth_border" />
            <corners android:radius="4dp" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>
</selector>
